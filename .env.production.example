# Hostinger Shared Hosting Production Configuration for admin.gadzio.co
APP_NAME="Gadzio General trading LLC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.gadzio.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Hostinger MySQL Database Credentials (u256101389)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u256101389_erp_db
DB_USERNAME=u256101389_erp_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# Shared Hosting File-Based Cache & Session (No Redis/Memcached required)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Mail Configuration (Hostinger SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@gadzio.co
MAIL_PASSWORD=YourEmailPasswordHere
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@gadzio.co"
MAIL_FROM_NAME="Gadzio General trading LLC"
